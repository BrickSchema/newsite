      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n          SELECT ?this\n          WHERE {\n            # every Setpoint subclass that is not deprecated\n            ?this rdfs:subClassOf+ brick:Setpoint .\n            FILTER NOT EXISTS { ?class owl:deprecated true }\n          }\n        "
      }
    ]
  },
