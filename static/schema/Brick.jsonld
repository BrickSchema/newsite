    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n            CONSTRUCT {\n$this ?invP ?o .\n}\nWHERE {\n# an incoming edge to this entity...\n?o ?p $this .\n# ...whose property is declared as the inverse of another\n?invP owl:inverseOf ?p .\n}\n\t\t\t"
      }
