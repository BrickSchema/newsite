  {
    "@id": "https://brickschema.org/schema/BrickShape#MeterInferSubclassNonBuildingMeter",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b444"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Meter"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b444",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this rdf:type ?metertype .\n        } WHERE {\n            # a meter with a substance...\n            $this rdf:type/rdfs:subClassOf* brick:Meter .\n            $this brick:hasSubstance ?substance .\n            # ...gets every meter class declaring that substance\n            ?metertype brick:hasSubstance ?substance .\n            ?metertype rdfs:subClassOf+ brick:Meter .\n            # skip building meters, and building meter classes\n            FILTER NOT EXISTS {\n                $this rdf:type/rdfs:subClassOf* brick:Building_Meter\n            }\n            MINUS {\n                ?metertype rdfs:subClassOf* brick:Building_Meter .\n            }\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
