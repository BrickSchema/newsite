  {
    "@id": "https://brickschema.org/schema/BrickShape#VirtualMeterRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b594"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "https://brickschema.org/schema/Brick#isVirtualMeter"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b594",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Only meters can have the isVirtualMeter property be true"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n                # a virtual-meter flag on something that is not a meter\n                $this brick:isVirtualMeter/brick:value true .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .\n            }\n        "
      }
    ]
  },
