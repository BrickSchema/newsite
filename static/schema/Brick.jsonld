  {
    "@id": "https://brickschema.org/schema/BrickShape#RDFSSubPropertyOfRuleForEntityProperties",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b532"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#subPropertyOf"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b532",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n            CONSTRUCT {\n                ?s ?super ?skolemized .\n                ?skolemized ?ep ?eo .\n            } WHERE {\n                # every entity-property ancestor of this entity property\n                $this rdfs:subPropertyOf+ ?super .\n                ?super a brick:EntityProperty .\n                $this a brick:EntityProperty .\n                # every use of this property\n                ?s $this ?o .\n                # a blank value node is replaced by a fresh IRI so the copy\n                # does not share the original node\n                BIND(IF(isBlank(?o), IRI(CONCAT(\"urn:skolem:\", STRUUID())), ?o) AS ?skolemized)\n                # the contents of the value node (brick:value, brick:hasUnit, ...)\n                ?o ?ep ?eo .\n            }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
