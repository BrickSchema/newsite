    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b458"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/2002/07/owl#equivalentClass"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b458",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?s a ?t2 .\n} WHERE {\n    # every instance of this class...\n    ?s a $this .\n    # ...also gets its equivalent classes, declared in either direction\n    { ?t2 owl:equivalentClass $this }\n    UNION\n    { $this owl:equivalentClass ?t2 }\n}"
      }
    ],
