  {
    "@id": "https://brickschema.org/schema/BrickShape#RDFSRangeRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b531"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#range"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b531",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?val a ?shape .\n} WHERE {\n    # the property's range is a shape, not a class...\n    $this rdfs:range ?shape .\n    ?shape a sh:NodeShape .\n    # ...so type every value of the property with it, if not already\n    ?ent $this ?val .\n    FILTER NOT EXISTS { ?val a ?shape }\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
