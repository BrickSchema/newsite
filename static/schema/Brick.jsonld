    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n$this brick:hasTag ?tag .\n} WHERE {\n    # the entity's class or any superclass of it...\n    $this rdf:type/rdfs:subClassOf* ?class .\n    # ...and the tags associated with it\n    ?class brick:hasAssociatedTag ?tag .\n}"
