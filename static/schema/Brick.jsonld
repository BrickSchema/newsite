  {
    "@id": "https://brickschema.org/schema/BrickShape#BuildingMeterRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b212"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Meter"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b212",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this rdf:type ?newtype .\n        }\n        WHERE {\n            # the meter meters a building...\n            $this brick:meters ?bldg .\n            VALUES ?bldgclass { brick:Building rec:Building }\n            ?bldg rdf:type/rdfs:subClassOf* ?bldgclass .\n            # ...so for each of its direct X_Meter types, mint brick:Building_X_Meter\n            $this rdf:type ?type .\n            BIND(IRI(CONCAT(\"https://brickschema.org/schema/Brick#Building_\", strafter(str(?type), \"https://brickschema.org/schema/Brick#\"))) as ?newtype) .\n            FILTER (strEnds(str(?type), \"_Meter\"))\n            # skip types that are already Building_ meters\n            FILTER (!strStarts(str(?type), \"https://brickschema.org/schema/Brick#Building_\"))\n            # only if Building_X_Meter exists\n            FILTER EXISTS { ?newtype a owl:Class }\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
