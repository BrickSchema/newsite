  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b414",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n?o ?prop $this .\n$this ?prop ?o .\n}\nWHERE {\n  # an edge in either direction...\n  { $this ?prop ?o } UNION { ?o ?prop $this } .\n  # ...over a symmetric property\n  ?prop a owl:SymmetricProperty .\n}\n\t\t\t"
      }
    ],
