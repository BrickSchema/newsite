    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n          SELECT ?this\n          WHERE {\n            # every Sensor subclass that is not deprecated\n            ?this rdfs:subClassOf+ brick:Sensor .\n            FILTER NOT EXISTS { ?class owl:deprecated true }\n          }\n        "
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b516",
    "@type": [
