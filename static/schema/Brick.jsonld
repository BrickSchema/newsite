  {
    "@id": "https://brickschema.org/schema/BrickShape#DeprecationInferenceForInstancesRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b241"
      }
    ],
