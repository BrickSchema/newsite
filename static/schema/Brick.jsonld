  {
    "@id": "https://brickschema.org/schema/BrickShape#MeterInferSubstance",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b445"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Meter"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b445",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this brick:hasSubstance ?substance .\n        } WHERE {\n            # the meter's direct meter class...\n            $this rdf:type ?meter .\n            ?meter rdfs:subClassOf* brick:Meter .\n            # ...and the substance that class declares\n            ?meter brick:hasSubstance ?substance .\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
