  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b406",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?s ?t2 ?o .\n} WHERE {\n    # finds every use of this property...\n    ?s $this ?o .\n    # ...and its equivalent, declared in either direction\n    { $this owl:equivalentProperty ?t2 }\n    UNION\n    { ?t2 owl:equivalentProperty $this }\n}"
      }
