  {
    "@id": "https://brickschema.org/schema/BrickShape#AutomationCollectionPointsRequireIsPointOf",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b210"
      }
    ],
    "http://www.w3.org/ns/shacl#target": [
      {
        "@id": "_:na4be112e16204247b3cef7d3afd8d561b211"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b210",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Points included in an Automation_Collection via rec:includes must have at least one brick:isPointOf relationship"
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://brickschema.org/schema/Brick#isPointOf"
      }
    ]
  },
  {
    "@id": "_:na4be112e16204247b3cef7d3afd8d561b211",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLTarget"
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n        PREFIX brick: <https://brickschema.org/schema/Brick#>\n        PREFIX rec: <https://w3id.org/rec#>\n        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n        SELECT DISTINCT ?this\n        WHERE {\n            # every point included, directly or through nested collections,\n            # in an Automation_Collection\n            ?collection rdf:type/rdfs:subClassOf* brick:Automation_Collection .\n            ?collection rec:includes+ ?this .\n            ?this rdf:type/rdfs:subClassOf* brick:Point .\n        }\n        "
      }
    ]
  },
  {
