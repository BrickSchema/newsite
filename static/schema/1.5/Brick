  <rdf:Description rdf:nodeID="neaf5965b7a3a4e1693b74b5830758a2eb415">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this brick:electricVehicleChargerDirectionality ?direction
        } WHERE {
            # the station this port is part of, and its directionality...
            $this rdf:type brick:Electric_Vehicle_Charging_Port .
            $this brick:isPartOf ?charger .
            ?charger a brick:Electric_Vehicle_Charging_Station .
            ?charger brick:electricVehicleChargerDirectionality ?direction .
            # ...unless the port declares its own
            FILTER NOT EXISTS {
                $this brick:electricVehicleChargerDirectionality ?other_direction .
            }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.5/Brick"/>
