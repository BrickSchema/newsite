  <rdf:Description rdf:nodeID="neaf5965b7a3a4e1693b74b5830758a2eb444">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this rdf:type ?metertype .
        } WHERE {
            # a meter with a substance...
            $this rdf:type/rdfs:subClassOf* brick:Meter .
            $this brick:hasSubstance ?substance .
            # ...gets every meter class declaring that substance
            ?metertype brick:hasSubstance ?substance .
            ?metertype rdfs:subClassOf+ brick:Meter .
            # skip building meters, and building meter classes
            FILTER NOT EXISTS {
                $this rdf:type/rdfs:subClassOf* brick:Building_Meter
            }
            MINUS {
                ?metertype rdfs:subClassOf* brick:Building_Meter .
            }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.5/Brick"/>
  </rdf:Description>
