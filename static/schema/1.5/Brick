  <rdf:Description rdf:nodeID="neaf5965b7a3a4e1693b74b5830758a2eb212">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this rdf:type ?newtype .
        }
        WHERE {
            # the meter meters a building...
            $this brick:meters ?bldg .
            VALUES ?bldgclass { brick:Building rec:Building }
            ?bldg rdf:type/rdfs:subClassOf* ?bldgclass .
            # ...so for each of its direct X_Meter types, mint brick:Building_X_Meter
            $this rdf:type ?type .
            BIND(IRI(CONCAT("https://brickschema.org/schema/Brick#Building_", strafter(str(?type), "https://brickschema.org/schema/Brick#"))) as ?newtype) .
            FILTER (strEnds(str(?type), "_Meter"))
            # skip types that are already Building_ meters
            FILTER (!strStarts(str(?type), "https://brickschema.org/schema/Brick#Building_"))
            # only if Building_X_Meter exists
            FILTER EXISTS { ?newtype a owl:Class }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.5/Brick"/>
  </rdf:Description>
