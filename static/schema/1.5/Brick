  <rdf:Description rdf:nodeID="neaf5965b7a3a4e1693b74b5830758a2eb197">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLRule"/>
    <sh:construct>
        CONSTRUCT {
            $this brick:electricVehicleChargerDirectionality [ brick:value "unidirectional"^^xsd:string ]
        } WHERE {
            $this rdf:type brick:Electric_Vehicle_Charging_Station .
            # the station has no directionality of its own...
            FILTER NOT EXISTS {
                $this brick:electricVehicleChargerDirectionality ?direction .
            }
            # ...and none of its ports has one either
            FILTER NOT EXISTS {
                $this brick:hasPart ?port .
                ?port a brick:Electric_Vehicle_Charging_Port .
                ?port brick:electricVehicleChargerDirectionality ?other_direction .
            }
        }
        </sh:construct>
    <sh:prefixes rdf:resource="https://brickschema.org/schema/1.5/Brick"/>
  </rdf:Description>
