      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@value": "Indicates membership in an organization. Note that componency (e.g., departments of a corporation) are expressed using the more generic hasPart property."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@value": "has member"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
