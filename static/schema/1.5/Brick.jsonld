  {
    "@id": "https://brickschema.org/schema/BrickShape#MeterInferSubclassBuildingMeter",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb443"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Building_Meter"
      }
    ]
  },
  {
    "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb443",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this rdf:type ?metertype .\n        } WHERE {\n            # a building meter with a substance...\n            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .\n            $this brick:hasSubstance ?substance .\n            # ...gets every building meter subclass declaring that substance\n            ?metertype brick:hasSubstance ?substance .\n            ?metertype rdfs:subClassOf+ brick:Building_Meter .\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
