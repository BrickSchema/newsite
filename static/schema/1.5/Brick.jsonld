  {
    "@id": "https://brickschema.org/schema/BrickShape#DeprecationInferenceForInstancesRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb241"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Entity"
      }
    ]
  },
  {
    "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb241",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "CONSTRUCT {\n$this a ?newClass .\n}\nWHERE {\n# the entity has a deprecated class...\n$this a ?class .\n?class owl:deprecated true .\n# ...which names a replacement the entity does not already have\n?class brick:isReplacedBy ?newClass .\nFILTER NOT EXISTS {$this a ?newClass}\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Deprecated class is temporarily augmented by the new class"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
