  {
    "@id": "https://brickschema.org/schema/BrickShape#TagInferenceRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb592"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
