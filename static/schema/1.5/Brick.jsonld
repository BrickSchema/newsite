    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The human, group, or machine that consumes or acts upon an object or data. This higher-level grouping allows properties that are shared among its subclasses (Person, Organization, ....) to be anchored in one joint place, on the Agent class."
      }
    ],
