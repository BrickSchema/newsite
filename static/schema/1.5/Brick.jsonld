      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A collection of equipment, points, and other automation collections that are logically grouped together for the purpose of management, control, or organization within a building automation system. We encourage that you develop your own sub-classes of Automation_Collection to represent specific groupings relevant to your use case."
      }
    ],
