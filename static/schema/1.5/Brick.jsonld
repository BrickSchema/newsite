  {
    "@id": "https://brickschema.org/schema/BrickShape#AddDefaultEVSEChargerDirection",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb197"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Electric_Vehicle_Charging_Station"
      }
    ]
  },
  {
    "@id": "_:neaf5965b7a3a4e1693b74b5830758a2eb197",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this brick:electricVehicleChargerDirectionality [ brick:value \"unidirectional\"^^xsd:string ]\n        } WHERE {\n            $this rdf:type brick:Electric_Vehicle_Charging_Station .\n            # the station has no directionality of its own...\n            FILTER NOT EXISTS {\n                $this brick:electricVehicleChargerDirectionality ?direction .\n            }\n            # ...and none of its ports has one either\n            FILTER NOT EXISTS {\n                $this brick:hasPart ?port .\n                ?port a brick:Electric_Vehicle_Charging_Port .\n                ?port brick:electricVehicleChargerDirectionality ?other_direction .\n            }\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.5/Brick"
      }
    ]
  },
